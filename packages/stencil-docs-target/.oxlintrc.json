{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {},
  "ignorePatterns": ["test/generator.test.ts"],
  "env": {
    "builtin": true,
    "node": true
  }
}
