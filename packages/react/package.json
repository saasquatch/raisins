{
  "name": "@raisins/react",
  "author": "ReferralSaaSquatch.com, Inc.",
  "description": "React package with tools for building a Raisins editor",
  "version": "1.7.2",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/react.esm.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/saasquatch/raisins",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": "^24 || ^26"
  },
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "storybook": "storybook dev -p 6007 -c .storybook",
    "storybook:build": "storybook build -c .storybook -o .out"
  },
  "peerDependencies": {
    "jotai": "^2.0.0",
    "react": "^17.0.0 || ^18.0.0"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/react.cjs.production.min.js",
      "limit": "150 KB"
    },
    {
      "path": "dist/react.esm.js",
      "limit": "150 KB"
    }
  ],
  "dependencies": {
    "@raisins/core": "^1.4.1",
    "@raisins/schema": "^1.4.0",
    "bunshi": "~2.0.2",
    "fast-equals": "^5.0.1",
    "hotkeys-js": "^3.8.7",
    "jotai-optics": "^0.4.0",
    "jotai-zustand": "^0.4.0",
    "jsonpointer": "^5.0.0",
    "optics-ts": "^2.2.0",
    "penpal": "^6.2.2",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.23.0",
    "prosemirror-schema-basic": "^1.2.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.35.0",
    "snabbdom": "^3.6.2",
    "style-to-object": "^0.3.0",
    "throttle-debounce": "^5.0.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@size-limit/preset-small-lib": "^5.0.4",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^24",
    "@types/react": "18",
    "@types/react-dom": "^18.3.0",
    "@types/throttle-debounce": "^5.0.0",
    "cypress": "^12.12.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "globals": "^15.2.0",
    "jsdom": "^31.0.0",
    "react": "*",
    "react-dom": "^18.3.1",
    "size-limit": "^5.0.4",
    "storybook": "^10.6.7",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "typescript-eslint": "^7.8.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "bugs": {
    "url": "https://github.com/saasquatch/raisins/issues"
  }
}
