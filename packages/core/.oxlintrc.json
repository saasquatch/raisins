{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {},
  "ignorePatterns": ["dist"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "vitest": true
  }
}
