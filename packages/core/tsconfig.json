{
  "$schema": "https://www.schemastore.org/tsconfig",

  "include": ["src/**/*.ts"],
  // Cypress-only specs use Cypress/Chai globals and are compiled by Cypress
  "exclude": ["src/**/*.web.test.ts"],

  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise",
      "dom",
      "dom.iterable"
    ],

    "noEmit": true,

    "module": "nodenext",
    "moduleResolution": "node16",
    "target": "esnext",
    "types": ["node", "jest"],

    // Best practices
    "allowJs": false,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true
  }
}
