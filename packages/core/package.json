{
  "name": "@raisins/core",
  "version": "1.4.1",
  "description": "Core functions for manipulating and validating HTML and raisin nodes",
  "bugs": {
    "url": "https://github.com/saasquatch/raisins/issues"
  },
  "license": "MIT",
  "author": "ReferralSaaSquatch.com, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/saasquatch/raisins",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run --project node",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project node --coverage",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@raisins/schema": "^1.4.0",
    "color2k": "^2.0.4",
    "css-select": "^5.2.2",
    "css-tree": "^1.1.3",
    "domelementtype": "^2.3.0",
    "entities": "^4.5.0",
    "lodash.clonedeep": "^4.5.0",
    "luxon": "^2.5.2"
  },
  "devDependencies": {
    "@saasquatch/scoped-autobindsteps": "^1.0.1",
    "@types/css-tree": "^1.0.7",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/luxon": "^2.4.0",
    "@types/mz": "^2.7.9",
    "@types/node": "^24.19.2",
    "@types/parse5": "^6.0.3",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "glob": "^7.2.3",
    "jest-cucumber": "^4.5.0",
    "jsdom": "^26.1.0",
    "jsonata": "^1.8.9",
    "mz": "^2.7.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "parse5": "^6.0.1",
    "playwright": "^1.65.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24 || ^26"
  }
}
